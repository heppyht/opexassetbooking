# OPEX VBM API — Local development variables
# Copy to .dev.vars and fill in values for `wrangler dev`.
# Never commit .dev.vars — it contains secrets.

APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
GEOTAB_DATABASE=opex_trial

# Service account for server-side AddInData access (set via `wrangler secret put`):
# GEOTAB_SERVICE_USERNAME
# GEOTAB_SERVICE_PASSWORD
# GEOTAB_SERVICE_SERVER
